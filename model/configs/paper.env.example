# Copy to a private shell file and edit paths. Do not commit credentials.
CAMARL_ROOT=/absolute/path/to/CAMARL
CAMARL_MODEL_ROOT=$CAMARL_ROOT/model
# Download raw data from REPLACE_WITH_RAW_DATASET_DOWNLOAD_URL.
MOSAICDIFF_ROOT=$CAMARL_ROOT/MosaicDiff
CAMARL_DATASET_ROOT=$MOSAICDIFF_ROOT
BASE_MODEL=/absolute/path/to/Qwen3.5-4B

# Paper configuration
POOL_SIZE=1000
NUM_GENERATIONS=4
MAX_STEPS=200
LEARNING_RATE=5e-7
GRPO_BETA=0.02
CLIP_EPSILON_LOW=0.20
CLIP_EPSILON_HIGH=0.28
ROLLOUT_TEMPERATURE=0.9
ROLLOUT_TOP_P=0.95
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
SEED=13
